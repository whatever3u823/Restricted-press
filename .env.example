# Postgres connection (local dev: see README)
DATABASE_URL=postgres://athenaeum:athenaeum@localhost:5432/athenaeum

# Better Auth
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000

# The Archivist (optional). Without a key the Archivist runs in sources-only
# mode: ranked, cited passages with no generated prose.
ANTHROPIC_API_KEY=
ARCHIVIST_MODEL=claude-opus-5-5

# Development only: lets a signed-in reader grant themselves a preview
# Fellowship from /membership while payments are not wired up.
ALLOW_DEV_UPGRADE=true
