    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
